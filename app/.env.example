DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/todo
TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/todo_test
REDIS_URL=redis://localhost:6379/0

AUTH_JWT_SECRET_KEY=change-me-to-a-long-random-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

AUTH_COOKIE_HTTPONLY=False
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=none

TIMEZONE=Asia/Tehran

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=100
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
